# Build outputs. Everything here is regenerated by `make` from config/, rtl/ and
# sim/, and nothing here is evidence: committing it would put multi-megabyte
# simulator objects in history and let a stale binary masquerade as a fresh
# build. Evidence lives in results/, which is tracked.
build/

# Firmware objects and images. Rebuilt by `make -C tests/programs all`.
tests/programs/build/

# Python bytecode.
__pycache__/
*.pyc

# Editor and OS noise.
.DS_Store
*.swp