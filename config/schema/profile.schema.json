{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mosaicrv.invalid/schema/profile.schema.json",
  "title": "MosaicRV frozen profile manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "xlen",
    "isa_target",
    "privilege_modes",
    "harts",
    "endianness",
    "misalignment",
    "csr_files",
    "memory_map_file",
    "geometry_file",
    "reset",
    "test_protocol"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "profile": { "type": "string", "enum": ["p0", "p1", "p2", "p3"] },
    "xlen": { "type": "integer", "enum": [64] },
    "isa_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "vlen", "elen", "source"],
      "properties": {
        "extensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$" }
        },
        "vlen": { "type": ["integer", "null"], "minimum": 128 },
        "elen": { "type": ["integer", "null"], "enum": [null, 32, 64] },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "privilege_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["M", "S", "U"] }
    },
    "harts": { "type": "integer", "minimum": 1, "maximum": 2 },
    "clusters": { "type": "integer", "minimum": 1, "maximum": 2 },
    "endianness": { "type": "string", "enum": ["little"] },
    "misalignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction_fetch", "load", "store", "atomic"],
      "properties": {
        "instruction_fetch": { "type": "string", "enum": ["trap", "emulate"] },
        "load": { "type": "string", "enum": ["trap", "emulate"] },
        "store": { "type": "string", "enum": ["trap", "emulate"] },
        "atomic": { "type": "string", "enum": ["trap", "raise_misaligned_fault"] }
      }
    },
    "reservation": {
      "description": "The platform's LR/SC reservation-set declaration. The size is stated here, not in the RTL: the case lrsc.reservation_progress takes its expected set size from this declaration and checks the RTL against it. For a profile that also ships an ACT/UDB platform declaration (tests/act4/mosaic-<profile>/sail.json), tools/mosaic/config_check.py cross-checks the two so they cannot drift.",
      "type": "object",
      "additionalProperties": false,
      "required": ["set_size_exp", "require_exact_addr"],
      "properties": {
        "set_size_exp": {
          "type": "integer",
          "minimum": 3,
          "maximum": 12,
          "description": "log2 of the naturally aligned reservation set size in bytes; 3 is the 8-byte XLEN-sized set RV64 requires as a minimum."
        },
        "require_exact_addr": {
          "type": "boolean",
          "description": "true when an SC must name the exact LR address to succeed, false when any address inside the reserved set may."
        }
      }
    },
    "csr_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^csr/.+\\.json$" }
    },
    "memory_map_file": { "type": "string", "pattern": "^memory/.+\\.json$" },
    "geometry_file": { "type": "string", "pattern": "^geometry/.+\\.json$" },
    "test_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tohost", "fromhost", "signature", "pass_code", "signature_words"],
      "description": "The platform test protocol shared by firmware, DUT and harness. Frozen here so the three cannot drift apart.",
      "properties": {
        "tohost": { "type": "integer", "minimum": 0, "maximum": 281474976710655 },
        "fromhost": { "type": "integer", "minimum": 0, "maximum": 281474976710655 },
        "signature": { "type": "integer", "minimum": 0, "maximum": 281474976710655 },
        "pass_code": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "signature_words": { "type": "integer", "minimum": 1, "maximum": 1024 }
      }
    },
    "reset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reset_vector", "boot_rom_bytes"],
      "properties": {
        "reset_vector": { "type": "integer", "minimum": 0, "maximum": 281474976710655 },
        "boot_rom_bytes": { "type": "integer", "minimum": 4, "maximum": 4096 }
      }
    },
    "derived_notes": { "type": "array", "items": { "type": "string" } }
  }
}